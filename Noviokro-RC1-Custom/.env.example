# Copy to .env inside Noviokro-RC1-Custom when using Docker Compose.
# Fill with a strong random local-development secret; do not commit .env.
NOVIOKRO_ADMIN_KEY=
# Docker reaches a backend running on the Windows host at this address.
NOVIOKRO_SERVICE_NOVEAM_BACKEND=http://host.docker.internal:8000
# Discovery does not enable either gateway.
NOVIOKRO_V12_ENABLE_PROXY=0
NOVIOKRO_V14_ENABLE_TELEMETRY=0

# Opt-in dedicated NOVEAM user API forwarding (enable only after choosing backend).
NOVIOKRO_NOVEAM_GATEWAY_ENABLED=0
NOVIOKRO_NOVEAM_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
